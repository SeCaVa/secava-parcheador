{
  "name": "secava-parcheador",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "install:firefox": "tsx scripts/install-firefox.ts",
    "catalog": "tsx scripts/sync-catalog.ts",
    "demo": "tsx scripts/generate-demo.ts",
    "build": "npm run typecheck && npm run catalog && vite build",
    "hash": "tsx scripts/hash-file.ts",
    "check:releases": "tsx scripts/check-releases.ts"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
